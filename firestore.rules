rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========== FONCTIONS UTILITAIRES ===========

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Le document appartient à l'utilisateur connecté (vérification sécurisée des champs)
    function isOwner() {
      return 'userId' in resource.data && resource.data.userId == request.auth.uid;
    }

    function isNewOwner() {
      return 'userId' in request.resource.data && request.resource.data.userId == request.auth.uid;
    }

    // Vrai si le document accorde des privilèges admin.
    function hasAdminPrivileges(data) {
      return ('isAdmin' in data && data.isAdmin == true)
        || ('roles' in data && data.roles is list && data.roles.hasAny(['admin', 'super-admin']));
    }

    // Lecture autorisée : admin OU propriétaire.
    function canReadResource() {
      return isAdmin() || isOwner();
    }

    // Lecture autorisée pour un membre d'équipe ayant reçu un partage.
    function canReadSharedResource() {
      return isSignedIn()
        && ('sharedWithUsers' in resource.data)
        && (resource.data.sharedWithUsers is list)
        && (request.auth.uid in resource.data.sharedWithUsers);
    }

    // 🔒 Vrai si `uid` est membre (ou propriétaire/admin) de l'équipe `teamId`.
    function isTeamMember(teamId, uid) {
      let teamDoc = get(/databases/$(database)/documents/teams/$(teamId));
      return teamId is string && uid is string && uid.size() > 0
        && teamDoc.data != null
        && (
          teamDoc.data.ownerId == uid
          || ('memberIds' in teamDoc.data && teamDoc.data.memberIds is list && uid in teamDoc.data.memberIds)
          || ('adminIds' in teamDoc.data && teamDoc.data.adminIds is list && uid in teamDoc.data.adminIds)
        );
    }

    // Création autorisée : admin OU utilisateur authentifié propriétaire.
    function canWriteOwnResource() {
      return isAdmin() || (isSignedIn() && isNewOwner());
    }

    // Mise à jour/suppression : admin OU propriétaire existant.
    function canUpdateOwnResource() {
      return isAdmin() || (isSignedIn() && isOwner());
    }

    // ===========================================
    // RESSOURCES "PAR UTILISATEUR"
    // ===========================================
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create: if canWriteOwnResource();
      allow update, delete: if isAdmin() || isOwner()
        || (companyId == 'default_company' && isAdmin());
    }
    match /clients/{clientId} {
      allow read: if isSignedIn() && (canReadResource() || canReadSharedResource());
      allow create: if canWriteOwnResource();
      allow update, delete: if canUpdateOwnResource();
    }
    match /products/{productId} {
      allow read: if isSignedIn() && (canReadResource() || canReadSharedResource());
      allow create: if canWriteOwnResource();
      allow update, delete: if canUpdateOwnResource();
    }
    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (canReadResource() || canReadSharedResource());
      allow create: if canWriteOwnResource();
      allow update, delete: if canUpdateOwnResource();
    }
    match /suppliers/{id} {
      allow read: if isSignedIn() && (canReadResource() || canReadSharedResource());
      allow create: if canWriteOwnResource();
      allow update, delete: if canUpdateOwnResource();
    }
    match /deliveries/{id} {
      allow read: if isSignedIn() && canReadResource();
      allow create: if canWriteOwnResource();
      allow update, delete: if canUpdateOwnResource();
    }
    match /reminders/{id} {
      allow read: if isSignedIn() && canReadResource();
      allow create: if canWriteOwnResource();
      allow update, delete: if canUpdateOwnResource();
    }
    match /dashboard_stats/{id} {
      allow read, write: if isSignedIn() && canUpdateOwnResource();
    }
    match /financial_stats/{id} {
      allow read, write: if isSignedIn() && canUpdateOwnResource();
    }
    match /analytics_data/{id} {
      allow read, write: if isSignedIn() && canUpdateOwnResource();
    }
    match /line_items/{id} {
      allow read: if isSignedIn() && canReadResource();
      allow create: if canWriteOwnResource();
      allow update, delete: if canUpdateOwnResource();
    }

    // ===========================================
    // ABONNEMENTS / SOUSCRIPTIONS / PLANS
    // ===========================================
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && (isAdmin() || isOwner());
      allow create: if isAdmin() || (isSignedIn() && isNewOwner());
      allow update, delete: if isAdmin();
    }
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Un utilisateur peut lire/mettre à jour SON propre profil.
    // L'utilisateur ne peut NI s'attribuer des privilèges admin NI modifier `isActive`.
    match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId
        && !hasAdminPrivileges(request.resource.data)
        && !('isActive' in request.resource.data);
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && !hasAdminPrivileges(request.resource.data)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive']));
    }

    // ===========================================
    // MODULE ÉQUIPE (Business) + PARTAGES
    // ===========================================
    match /teams/{teamId} {
      allow read: if isSignedIn() && (isAdmin()
        || resource.data.ownerId == request.auth.uid
        || ('memberIds' in resource.data && request.auth.uid in resource.data.memberIds));
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin()
        || resource.data.ownerId == request.auth.uid;
    }
    match /shared_invoices/{sharedId} {
      allow read: if isSignedIn() && (isAdmin()
        || ('sharedWith' in resource.data && request.auth.uid in resource.data.sharedWith)
        || resource.data.sharedBy == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.sharedBy == request.auth.uid
        && request.resource.data.teamId is string
        && isTeamMember(request.resource.data.teamId, request.auth.uid);
      allow update, delete: if isAdmin()
        || resource.data.sharedBy == request.auth.uid;
    }

    // ===========================================
    // INVITATIONS D'ÉQUIPE
    // ===========================================
    match /team_invitations/{invitationId} {
      allow read: if isSignedIn() && (isAdmin()
        || resource.data.inviteeUid == request.auth.uid
        || isTeamMember(resource.data.teamId, request.auth.uid));
      allow write: if isAdmin();
    }

    // ===========================================
    // MESSAGERIE D'ÉQUIPE
    // ===========================================
    match /team_messages/{teamId} {
      allow read, write: if isAdmin()
        || isTeamMember(teamId, request.auth.uid);

      match /messages/{messageId} {
        allow read: if isAdmin() || isTeamMember(teamId, request.auth.uid);
        allow create: if isSignedIn()
          && isTeamMember(teamId, request.auth.uid)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin()
          || (isTeamMember(teamId, request.auth.uid)
              && resource.data.senderId == request.auth.uid);
      }
    }

    // ===========================================
    // SYSTÈME
    // ===========================================
    match /templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isAdmin() || isOwner()
        || ('recipients' in resource.data && resource.data.recipients is list && request.auth.uid in resource.data.recipients));
      allow write: if isAdmin() || (isSignedIn() && (isNewOwner()
        || (request.resource.data.createdBy == request.auth.uid
            && request.resource.data.teamId is string
            && isTeamMember(request.resource.data.teamId, request.auth.uid)
            && request.resource.data.userId is string
            && isTeamMember(request.resource.data.teamId, request.resource.data.userId))));
    }
    match /fcm_tokens/{tokenId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
    match /logs/{logId} {
      allow read, write: if isAdmin();
    }
    match /drive_sync/{syncId} {
      allow read: if isSignedIn() && (isAdmin() || isOwner());
      allow write: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
    }
    match /counters/{counterId} {
      allow read, write: if isSignedIn() && request.auth.uid == counterId;
    }

    // ===========================================
    // PORTEFEUILLE MARCHAND
    // ===========================================
    match /wallets/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
    match /wallet_transactions/{id} {
      allow read: if isSignedIn()
        && (isAdmin() || isOwner());
      allow create: if isAdmin();
    }
    match /wallet_withdrawals/{id} {
      allow read: if isSignedIn()
        && (isAdmin() || isOwner());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }
  }
}