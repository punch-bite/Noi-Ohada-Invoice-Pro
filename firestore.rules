rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════
    // FONCTIONS UTILITAIRES
    // ═══════════════════════════════════════════════════════════════════
    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    function myCompanyId() {
      return isSignedIn() ? request.auth.token.companyId : null;
    }
    function myTeamIds() {
      return isSignedIn() && request.auth.token.teamIds is list
        ? request.auth.token.teamIds
        : [];
    }

    // 🔒 FIX CRITIQUE : Le `userId` d'un document ne peut JAMAIS changer
    //    sur un update. Peu importe qui écrit (admin, membre d'équipe, etc.),
    //    le propriétaire d'origine est PRÉSERVÉ. C'est la protection la plus
    //    fiable contre l'écrasement accidentel.
    //
    //    ⚠️ Si le champ n'existe pas dans l'ancien doc (migration initiale),
    //    on autorise la première écriture qui le pose.
    function userIdUnchanged() {
      return !('userId' in resource.data)
        || !('userId' in request.resource.data)
        || request.resource.data.userId == resource.data.userId;
    }

    // 🔒 Le `companyId` suit la même règle : on ne change pas d'entreprise
    //    en modifiant un document.
    function companyIdUnchanged() {
      return !('companyId' in resource.data)
        || !('companyId' in request.resource.data)
        || request.resource.data.companyId == resource.data.companyId;
    }

    // 🔒 Vérifie que les champs sensibles d'ownership sont préservés.
    function ownershipPreserved() {
      return userIdUnchanged() && companyIdUnchanged();
    }

    function isOwner() {
      return isSignedIn() && (
        ('userId' in resource.data && resource.data.userId == request.auth.uid)
        || ('companyId' in resource.data
            && myCompanyId() != null
            && resource.data.companyId == myCompanyId())
      );
    }
    function isNewOwner() {
      return isSignedIn() && (
        ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
        || ('companyId' in request.resource.data
            && myCompanyId() != null
            && request.resource.data.companyId == myCompanyId())
      );
    }

    function hasAdminPrivileges(data) {
      return ('isAdmin' in data && data.isAdmin == true)
          || ('roles' in data && data.roles is list
              && data.roles.hasAny(['admin', 'super-admin']));
    }

    function canReadResource()      { return isAdmin() || isOwner(); }
    function canWriteOwnResource()  { return isAdmin() || isNewOwner(); }
    function canUpdateOwnResource() { return isAdmin() || isOwner(); }

    function isTeamMember(teamId, uid) {
      let team = get(/databases/$(database)/documents/teams/$(teamId)).data;
      return teamId is string
        && uid is string
        && uid.size() > 0
        && team != null
        && (team.ownerId == uid
            || ('memberIds' in team && team.memberIds is list && uid in team.memberIds)
            || ('adminIds' in team && team.adminIds is list && uid in team.adminIds));
    }

    function canReadSharedResource() {
      return isSignedIn() && (
        ('sharedWithUsers' in resource.data
          && resource.data.sharedWithUsers is list
          && request.auth.uid in resource.data.sharedWithUsers)
        || ('sharedTeams' in resource.data
            && resource.data.sharedTeams is list
            && resource.data.sharedTeams.size() > 0
            && resource.data.sharedTeams.hasAny(myTeamIds()))
      );
    }
    function canWriteSharedResource() {
      return isSignedIn()
        && ('editableByUsers' in resource.data)
        && request.auth.uid in resource.data.editableByUsers;
    }

    // ═══════════════════════════════════════════════════════════════════
    // RESSOURCES "PAR UTILISATEUR / ENTREPRISE"
    // ═══════════════════════════════════════════════════════════════════
    match /companies/{companyId} {
      allow read:   if isSignedIn() && (canReadResource() || canReadSharedResource());
      allow create: if canWriteOwnResource();
      allow update, delete: if (canUpdateOwnResource() && ownershipPreserved())
        || (companyId == 'default_company' && isAdmin());
    }

    match /clients/{clientId} {
      allow read:   if isSignedIn() && (canReadResource() || canReadSharedResource());
      allow create: if canWriteOwnResource();
      allow update: if (canUpdateOwnResource() || canWriteSharedResource())
        && ownershipPreserved();  // 🔒
      allow delete: if canUpdateOwnResource() || canWriteSharedResource();
    }
    match /products/{productId} {
      allow read:   if isSignedIn() && (canReadResource() || canReadSharedResource());
      allow create: if canWriteOwnResource();
      allow update: if (canUpdateOwnResource() || canWriteSharedResource())
        && ownershipPreserved();  // 🔒
      allow delete: if canUpdateOwnResource() || canWriteSharedResource();
    }
    match /invoices/{invoiceId} {
      allow read:   if isSignedIn() && (canReadResource() || canReadSharedResource());
      allow create: if canWriteOwnResource();
      allow update: if (canUpdateOwnResource() || canWriteSharedResource())
        && ownershipPreserved();  // 🔒
      allow delete: if canUpdateOwnResource() || canWriteSharedResource();
    }
    match /suppliers/{id} {
      allow read:   if isSignedIn() && (canReadResource() || canReadSharedResource());
      allow create: if canWriteOwnResource();
      allow update: if (canUpdateOwnResource() || canWriteSharedResource())
        && ownershipPreserved();  // 🔒
      allow delete: if canUpdateOwnResource() || canWriteSharedResource();
    }
    match /deliveries/{id} {
      allow read:   if isSignedIn() && (canReadResource() || canReadSharedResource());
      allow create: if canWriteOwnResource();
      allow update: if (canUpdateOwnResource() || canWriteSharedResource())
        && ownershipPreserved();  // 🔒
      allow delete: if canUpdateOwnResource() || canWriteSharedResource();
    }
    match /reminders/{id} {
      allow read:   if isSignedIn() && (canReadResource() || canReadSharedResource());
      allow create: if canWriteOwnResource();
      allow update: if (canUpdateOwnResource() || canWriteSharedResource())
        && ownershipPreserved();  // 🔒
      allow delete: if canUpdateOwnResource() || canWriteSharedResource();
    }

    // ─── Les stats / analytics restent sans la contrainte ownership ───
    match /dashboard_stats/{id} {
      allow read, write: if isSignedIn() && canUpdateOwnResource();
    }
    match /financial_stats/{id} {
      allow read, write: if isSignedIn() && canUpdateOwnResource();
    }
    match /analytics_data/{id} {
      allow read, write: if isSignedIn() && canUpdateOwnResource();
    }
    match /line_items/{id} {
      allow read:   if isSignedIn() && canReadResource();
      allow create: if canWriteOwnResource();
      allow update, delete: if canUpdateOwnResource();
    }

    // ═══════════════════════════════════════════════════════════════════
    // ABONNEMENTS / PLANS
    // ═══════════════════════════════════════════════════════════════════
    match /subscriptions/{subscriptionId} {
      allow read:   if isSignedIn() && (isAdmin() || isOwner());
      allow create: if isAdmin() || (isSignedIn() && isNewOwner()
        && request.resource.data.status == 'pending'
        && request.resource.data.amount == 0);
      allow update: if isAdmin()
        || (isSignedIn() && isOwner()
            && !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(['planId','amount','currency','status','paymentId','paymentMethod'])
            && ownershipPreserved());  // 🔒
      allow delete: if isAdmin();
    }
    match /plans/{planId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // USERS
    // ═══════════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId
        && !hasAdminPrivileges(request.resource.data)
        && !('isActive' in request.resource.data);
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && !hasAdminPrivileges(request.resource.data)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive']));
    }

    // ═══════════════════════════════════════════════════════════════════
    // TEAMS / PARTAGES
    // ═══════════════════════════════════════════════════════════════════
    match /teams/{teamId} {
      allow read: if isSignedIn() && (isAdmin()
        || resource.data.ownerId == request.auth.uid
        || ('memberIds' in resource.data && request.auth.uid in resource.data.memberIds));
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin()
        || resource.data.ownerId == request.auth.uid;
    }
    match /shared_invoices/{sharedId} {
      allow read: if isSignedIn() && (isAdmin()
        || ('sharedWith' in resource.data && resource.data.sharedWith is list
            && request.auth.uid in resource.data.sharedWith)
        || ('writeUsers' in resource.data && resource.data.writeUsers is list
            && request.auth.uid in resource.data.writeUsers)
        || resource.data.sharedBy == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.sharedBy == request.auth.uid
        && request.resource.data.teamId is string
        && isTeamMember(request.resource.data.teamId, request.auth.uid);
      allow update, delete: if isAdmin()
        || resource.data.sharedBy == request.auth.uid;
    }
    match /team_invitations/{invitationId} {
      allow read: if isSignedIn() && (isAdmin()
        || resource.data.inviteeUid == request.auth.uid
        || isTeamMember(resource.data.teamId, request.auth.uid));
      allow write: if isAdmin();
    }
    match /team_messages/{teamId} {
      allow read, write: if isAdmin()
        || isTeamMember(teamId, request.auth.uid);

      match /messages/{messageId} {
        allow read: if isAdmin() || isTeamMember(teamId, request.auth.uid);
        allow create: if isSignedIn()
          && isTeamMember(teamId, request.auth.uid)
          && request.resource.data.senderId == request.auth.uid
          && (!('ownerId' in request.resource.data)
              || request.resource.data.ownerId == ''
              || request.resource.data.ownerId == request.auth.uid
              || request.resource.data.ownerId ==
                 get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId);
        allow update, delete: if isAdmin()
          || (isTeamMember(teamId, request.auth.uid)
              && resource.data.senderId == request.auth.uid);
      }
    }

    // ═══════════════════════════════════════════════════════════════════
    // SYSTÈME
    // ═══════════════════════════════════════════════════════════════════
    match /templates/{templateId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isAdmin() || isOwner()
        || ('recipients' in resource.data && resource.data.recipients is list
            && request.auth.uid in resource.data.recipients));
      allow write: if isAdmin() || (isSignedIn() && (isNewOwner()
        || (request.resource.data.createdBy == request.auth.uid
            && request.resource.data.teamId is string
            && isTeamMember(request.resource.data.teamId, request.auth.uid)
            && request.resource.data.userId is string
            && isTeamMember(request.resource.data.teamId, request.resource.data.userId))));
    }
    match /fcm_tokens/{tokenId} {
      allow read:   if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
    match /logs/{logId} {
      allow read, write: if isAdmin();
    }
    match /admin_audit_log/{logId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }
    match /drive_sync/{syncId} {
      allow read:  if isSignedIn() && (isAdmin() || isOwner());
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /counters/{scopeId} {
      allow read, write: if isSignedIn()
        && (request.auth.uid == scopeId || myCompanyId() == scopeId);
    }

    // ═══════════════════════════════════════════════════════════════════
    // PORTEFEUILLE
    // ═══════════════════════════════════════════════════════════════════
    match /wallets/{userId} {
      allow read:  if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
    match /wallet_transactions/{id} {
      allow read:   if isSignedIn() && (isAdmin() || isOwner());
      allow create: if isAdmin();
      allow update: if isAdmin() && ownershipPreserved();
    }
    match /wallet_withdrawals/{id} {
      allow read:   if isSignedIn() && (isAdmin() || isOwner());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }
  }
}