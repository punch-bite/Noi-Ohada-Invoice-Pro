rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }

    // Plans (lecture publique)
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Abonnements
    match /subscriptions/{subscriptionId} {
      allow read, write: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Utilisateurs
    match /users/{userId} {
      allow read, write: if isAuthenticated() && (isAdmin() || isOwner(userId));
    }

    // Factures
    match /invoices/{invoiceId} {
      allow read, write: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Clients
    match /clients/{clientId} {
      allow read, write: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Entreprises
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Modèles de factures
    match /templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Logs
    match /logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Paramètres
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Produits
    match /products/{productId} {
      allow read, write: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Fournisseurs
    match /suppliers/{supplierId} {
      allow read, write: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Livraisons
    match /deliveries/{deliveryId} {
      allow read, write: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
    }
  }
}