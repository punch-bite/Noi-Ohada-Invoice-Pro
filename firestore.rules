rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    //  HELPERS — 100% SAFE (pas de crash si doc absent)
    // ═══════════════════════════════════════════════════════════════
    function isSignedIn() {
      return request.auth != null;
    }

    // Lit le doc user de l'appelant — retourne null si absent (pas de crash).
    function myUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    // Admin = claim admin OU champ isAdmin OU role admin.
    function isAdmin() {
      if (!isSignedIn()) return false;
      if (request.auth.token.admin == true) return true;
      let u = myUserDoc();
      return u != null && (
        ('isAdmin' in u && u.isAdmin == true)
        || ('roles' in u && u.roles is list
            && u.roles.hasAny(['admin', 'super-admin']))
      );
    }

    // Company de l'appelant.
    function myCompanyId() {
      let u = myUserDoc();
      return u != null && ('companyId' in u) && u.companyId is string
        ? u.companyId
        : null;
    }

    // UID de l'appelant.
    function myUid() {
      return isSignedIn() ? request.auth.uid : '';
    }

    // Membre d'équipe — SAFE (vérifie exists() avant get).
    function isTeamMember(teamId, uid) {
      if (teamId is! string || uid is! string || uid.size() == 0) return false;
      if (!exists(/databases/$(database)/documents/teams/$(teamId))) return false;
      let team = get(/databases/$(database)/documents/teams/$(teamId)).data;
      return team != null && (
        team.ownerId == uid
        || ('memberIds' in team && team.memberIds is list && uid in team.memberIds)
        || ('adminIds' in team && team.adminIds is list && uid in team.adminIds)
      );
    }

    // Anti-écrasement : userId et companyId ne changent jamais sur update.
    function ownershipPreserved() {
      let userOk = !('userId' in resource.data)
        || !('userId' in request.resource.data)
        || request.resource.data.userId == resource.data.userId;
      let companyOk = !('companyId' in resource.data)
        || !('companyId' in request.resource.data)
        || request.resource.data.companyId == resource.data.companyId;
      return userOk && companyOk;
    }

    // Vrai si l'utilisateur peut LIRE un doc (owner OU même company OU shared OU admin).
    function canReadDoc() {
      if (isAdmin()) return true;
      if ('userId' in resource.data && resource.data.userId == myUid()) return true;
      if ('companyId' in resource.data
          && myCompanyId() != null
          && resource.data.companyId == myCompanyId()) return true;
      if ('sharedWithUsers' in resource.data
          && resource.data.sharedWithUsers is list
          && myUid() in resource.data.sharedWithUsers) return true;
      return false;
    }

    // Vrai si l'utilisateur peut ÉCRIRE un doc.
    function canWriteDoc() {
      if (isAdmin()) return true;
      if ('userId' in resource.data && resource.data.userId == myUid()) return true;
      if ('companyId' in resource.data
          && myCompanyId() != null
          && resource.data.companyId == myCompanyId()) return true;
      if ('editableByUsers' in resource.data
          && resource.data.editableByUsers is list
          && myUid() in resource.data.editableByUsers) return true;
      return false;
    }

    // Vrai si le nouvel owner est bien l'appelant (ou sa company).
    function isNewOwner() {
      if (!isSignedIn()) return false;
      if ('userId' in request.resource.data
          && request.resource.data.userId == myUid()) return true;
      if ('companyId' in request.resource.data
          && myCompanyId() != null
          && request.resource.data.companyId == myCompanyId()) return true;
      return false;
    }

    // ═══════════════════════════════════════════════════════════════
    //  FALLBACK : collections non listées → tout authentifié.
    // ═══════════════════════════════════════════════════════════════
    match /{collection}/{docId} {
      allow read, write: if isSignedIn();
    }

    // ═══════════════════════════════════════════════════════════════
    //  USERS
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isSignedIn()
        && (userId == myUid() || isAdmin());

      allow create: if isSignedIn()
        && userId == myUid();

      allow update: if isSignedIn()
        && (userId == myUid() || isAdmin());

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  COMPANIES
    // ═══════════════════════════════════════════════════════════════
    match /companies/{companyId} {
      allow read: if isSignedIn() && (companyId == myCompanyId() || isAdmin()
        || ('userId' in resource.data && resource.data.userId == myUid()));

      allow create: if isSignedIn()
        && request.resource.data.userId == myUid();

      allow update, delete: if isSignedIn()
        && ownershipPreserved()
        && (resource.data.userId == myUid() || isAdmin());
    }

    // ═══════════════════════════════════════════════════════════════
    //  CLIENTS / PRODUCTS / INVOICES / SUPPLIERS
    //  Règle identique : owner OU même company OU shared OU admin
    // ═══════════════════════════════════════════════════════════════
    match /clients/{id} {
      allow read:   if isSignedIn() && canReadDoc();
      allow create: if isSignedIn() && isNewOwner();
      allow update: if isSignedIn() && canWriteDoc() && ownershipPreserved();
      allow delete: if isSignedIn()
        && ('userId' in resource.data && resource.data.userId == myUid()
            || isAdmin());
    }

    match /products/{id} {
      allow read:   if isSignedIn() && canReadDoc();
      allow create: if isSignedIn() && isNewOwner();
      allow update: if isSignedIn() && canWriteDoc() && ownershipPreserved();
      allow delete: if isSignedIn()
        && ('userId' in resource.data && resource.data.userId == myUid()
            || isAdmin());
    }

    match /invoices/{id} {
      allow read:   if isSignedIn() && canReadDoc();
      allow create: if isSignedIn() && isNewOwner();
      allow update: if isSignedIn() && canWriteDoc() && ownershipPreserved();
      allow delete: if isSignedIn()
        && ('userId' in resource.data && resource.data.userId == myUid()
            || isAdmin());
    }

    match /suppliers/{id} {
      allow read:   if isSignedIn() && canReadDoc();
      allow create: if isSignedIn() && isNewOwner();
      allow update: if isSignedIn() && canWriteDoc() && ownershipPreserved();
      allow delete: if isSignedIn()
        && ('userId' in resource.data && resource.data.userId == myUid()
            || isAdmin());
    }

    // ═══════════════════════════════════════════════════════════════
    //  DELIVERIES / REMINDERS / STATS — moins critiques
    // ═══════════════════════════════════════════════════════════════
    match /deliveries/{id} {
      allow read:   if isSignedIn() && canReadDoc();
      allow create: if isSignedIn() && isNewOwner();
      allow update: if isSignedIn() && canWriteDoc() && ownershipPreserved();
      allow delete: if isSignedIn() && canWriteDoc();
    }

    match /reminders/{id} {
      allow read:   if isSignedIn() && canReadDoc();
      allow create: if isSignedIn() && isNewOwner();
      allow update: if isSignedIn() && canWriteDoc() && ownershipPreserved();
      allow delete: if isSignedIn() && canWriteDoc();
    }

    match /dashboard_stats/{id} {
      allow read, write: if isSignedIn();
    }
    match /financial_stats/{id} {
      allow read, write: if isSignedIn();
    }
    match /analytics_data/{id} {
      allow read, write: if isSignedIn();
    }
    match /line_items/{id} {
      allow read, write: if isSignedIn();
    }

    // ═══════════════════════════════════════════════════════════════
    //  PLANS / TEMPLATES / SETTINGS
    // ═══════════════════════════════════════════════════════════════
    match /plans/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    match /templates/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  SUBSCRIPTIONS
    // ═══════════════════════════════════════════════════════════════
    match /subscriptions/{id} {
      allow read: if isSignedIn() && (isAdmin()
        || ('userId' in resource.data && resource.data.userId == myUid()));

      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.userId == myUid()
            && request.resource.data.status == 'pending'
            && request.resource.data.amount == 0);

      allow update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  TEAMS
    // ═══════════════════════════════════════════════════════════════
    match /teams/{teamId} {
      allow read: if isSignedIn() && (isAdmin()
        || (('ownerId' in resource.data) && resource.data.ownerId == myUid())
        || (('memberIds' in resource.data)
            && resource.data.memberIds is list
            && myUid() in resource.data.memberIds));

      allow create: if isSignedIn()
        && request.resource.data.ownerId == myUid();

      allow update, delete: if isSignedIn()
        && (resource.data.ownerId == myUid() || isAdmin());
    }

    // ═══════════════════════════════════════════════════════════════
    //  SHARED INVOICES
    // ═══════════════════════════════════════════════════════════════
    match /shared_invoices/{id} {
      allow read: if isSignedIn() && (isAdmin()
        || (('sharedWith' in resource.data)
            && resource.data.sharedWith is list
            && myUid() in resource.data.sharedWith)
        || (('sharedBy' in resource.data) && resource.data.sharedBy == myUid()));

      allow create: if isSignedIn()
        && request.resource.data.sharedBy == myUid()
        && isTeamMember(request.resource.data.teamId, myUid());

      allow update, delete: if isSignedIn()
        && (resource.data.sharedBy == myUid() || isAdmin());
    }

    // ═══════════════════════════════════════════════════════════════
    //  TEAM INVITATIONS
    // ═══════════════════════════════════════════════════════════════
    match /team_invitations/{id} {
      allow read: if isSignedIn() && (isAdmin()
        || (('inviteeUid' in resource.data)
            && resource.data.inviteeUid == myUid()));

      allow write: if isSignedIn() && isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  TEAM MESSAGES (sous-collection)
    // ═══════════════════════════════════════════════════════════════
    match /team_messages/{teamId} {
      allow read: if isSignedIn()
        && (isAdmin() || isTeamMember(teamId, myUid()));

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && (isAdmin() || isTeamMember(teamId, myUid()));

        allow create: if isSignedIn()
          && isTeamMember(teamId, myUid())
          && request.resource.data.senderId == myUid();

        allow update, delete: if isSignedIn()
          && (isAdmin()
              || (('senderId' in resource.data)
                  && resource.data.senderId == myUid()));
      }
    }

    // ═══════════════════════════════════════════════════════════════
    //  NOTIFICATIONS
    // ═══════════════════════════════════════════════════════════════
    match /notifications/{id} {
      allow read: if isSignedIn() && (isAdmin()
        || (('userId' in resource.data) && resource.data.userId == myUid())
        || (('recipients' in resource.data)
            && resource.data.recipients is list
            && myUid() in resource.data.recipients));

      allow create, update: if isSignedIn()
        && (isAdmin()
            || (('userId' in request.resource.data)
                && request.resource.data.userId == myUid()));

      allow delete: if isSignedIn()
        && (isAdmin()
            || (('userId' in resource.data) && resource.data.userId == myUid()));
    }

    // ═══════════════════════════════════════════════════════════════
    //  FCM TOKENS
    // ═══════════════════════════════════════════════════════════════
    match /fcm_tokens/{id} {
      allow read, write: if isSignedIn()
        && (('uid' in request.resource.data) && request.resource.data.uid == myUid()
            || isAdmin());
    }

    // ═══════════════════════════════════════════════════════════════
    //  LOGS / AUDIT (admin only)
    // ═══════════════════════════════════════════════════════════════
    match /logs/{id} {
      allow read, write: if isAdmin();
    }
    match /admin_audit_log/{id} {
      allow read, write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  DRIVE SYNC
    // ═══════════════════════════════════════════════════════════════
    match /drive_sync/{id} {
      allow read, write: if isSignedIn()
        && (('userId' in request.resource.data) && request.resource.data.userId == myUid()
            || isAdmin());
    }

    // ═══════════════════════════════════════════════════════════════
    //  COUNTERS
    // ═══════════════════════════════════════════════════════════════
    match /counters/{scopeId} {
      allow read, write: if isSignedIn()
        && (scopeId == myUid()
            || (myCompanyId() != null && scopeId == myCompanyId()));
    }

    // ═══════════════════════════════════════════════════════════════
    //  WALLETS
    // ═══════════════════════════════════════════════════════════════
    match /wallets/{userId} {
      allow read: if isSignedIn()
        && (userId == myUid() || isAdmin());
      allow write: if isAdmin();
    }
    match /wallet_transactions/{id} {
      allow read: if isSignedIn() && (isAdmin()
        || (('userId' in resource.data) && resource.data.userId == myUid()));
      allow create: if isAdmin();
    }
    match /wallet_withdrawals/{id} {
      allow read: if isSignedIn() && (isAdmin()
        || (('userId' in resource.data) && resource.data.userId == myUid()));
      allow create: if isSignedIn()
        && request.resource.data.userId == myUid();
      allow update: if isAdmin();
    }
  }
}