rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========== FONCTIONS UTILITAIRES ===========
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    function isAuthenticated() { return request.auth != null; }
    // Vrai si le document appartient à l'utilisateur connecté ou si c'est un admin.
    function isUserResource() {
      return isAdmin() || resource.data.userId == request.auth.uid;
    }
    // Vrai si le document en cours d'écriture est assigné à l'utilisateur connecté.
    function canWriteUserResource() {
      return isAdmin() || request.resource.data.userId == request.auth.uid;
    }

    // =========== RESSOURCES "PAR UTILISATEUR" ===========
    // Chaque utilisateur ne peut LIRE/ÉCRIRE que SES documents (userId == uid).
    // L'administrateur a accès à TOUTES les données de tous les utilisateurs.

    // Clients (par utilisateur)
    match /clients/{clientId} {
      allow read, write: if isAuthenticated() && isUserResource();
    }

    // Produits (par utilisateur)
    match /products/{productId} {
      allow read, write: if isAuthenticated() && isUserResource();
    }

    // Factures (par utilisateur)
    match /invoices/{invoiceId} {
      allow read, write: if isAuthenticated() && isUserResource();
    }

    // Fournisseurs (par utilisateur)
    match /suppliers/{supplierId} {
      allow read, write: if isAuthenticated() && isUserResource();
    }

    // Livraisons (par utilisateur)
    match /deliveries/{deliveryId} {
      allow read, write: if isAuthenticated() && isUserResource();
    }

    // Entreprises — CHAQUE utilisateur n'a accès qu'à SA company.
    // L'utilisateur connecté ne peut voir que sa propre entreprise,
    // l'admin voit/édite toutes.
    match /companies/{companyId} {
      allow read: if isAuthenticated() && isUserResource();
      allow write: if isAuthenticated() && canWriteUserResource();
    }

    // Abonnements (par utilisateur) — chaque user ne voit que le sien.
    match /subscriptions/{subscriptionId} {
      allow read, write: if isAuthenticated() && isUserResource();
    }

    // Utilisateurs — chaque user accède à son propre document profile.
    match /users/{userId} {
      allow read, write: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
    }

    // =========== RESSOURCES PARTAGÉES / SYSTÈME ===========
    // Plans : lecture publique (nécessaire pour afficher les prix), écriture admin.
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Modèles de factures : lecture pour tout utilisateur authentifié
    // (modèles génériques partagés), écriture admin.
    match /templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Paramètres généraux (système) : lecture authentifiée, écriture admin.
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Logs système : accès admin uniquement.
    match /logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}