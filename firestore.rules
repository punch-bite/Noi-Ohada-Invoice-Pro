rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========== FONCTIONS UTILITAIRES ===========
    // ⚠️ Langage des règles Firestore = langage d'EXPRESSIONS.
    // Pas de `if`, `for`, `let`, `while` — uniquement des expressions.

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Le document appartient à l'utilisateur connecté.
    function isOwner() {
      return resource.data.userId == request.auth.uid;
    }
    function isNewOwner() {
      return request.resource.data.userId == request.auth.uid;
    }

    // Vrai si le document (nouveau ou existant) accorde des privilèges admin.
    function hasAdminPrivileges(data) {
      return data.isAdmin == true
        || ('roles' in data && data.roles.hasAny(['admin', 'super-admin']));
    }

    // Lecture autorisée : admin OU propriétaire.
    function canReadResource() {
      return isAdmin() || isOwner();
    }

    // Lecture autorisée pour un membre d'équipe ayant reçu un partage.
    // Le partage est matérialisé sur le document (sharedWithUsers) par l'émetteur.
    function canReadSharedResource() {
      return isSignedIn()
        && (request.auth.uid in resource.data.sharedWithUsers);
    }

    // 🔒 Vrai si `uid` est membre (ou propriétaire/admin) de l'équipe `teamId`.
    function isTeamMember(teamId, uid) {
      return teamId is string && uid is string && uid.size() > 0
        && get(/databases/$(database)/documents/teams/$(teamId)).data != null
        && (
          get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid
          || uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds
          || uid in get(/databases/$(database)/documents/teams/$(teamId)).data.adminIds
        );
    }

    // Création autorisée : admin OU utilisateur authentifié propriétaire.
    // NB : le champ `userId` doit être présent pour les collections métier.
    function canWriteOwnResource() {
      return isAdmin() || (isSignedIn() && isNewOwner());
    }

    // Mise à jour/suppression : admin OU propriétaire existant.
    function canUpdateOwnResource() {
      return isAdmin() || (isSignedIn() && isOwner());
    }

    // ===========================================
    // RESSOURCES "PAR UTILISATEUR"
    // ===========================================
    match /clients/{clientId} {
      allow read: if isSignedIn() && (canReadResource() || canReadSharedResource());
      allow create: if canWriteOwnResource();
      allow update, delete: if canUpdateOwnResource();
    }
    match /products/{productId} {
      allow read: if isSignedIn() && (canReadResource() || canReadSharedResource());
      allow create: if canWriteOwnResource();
      allow update, delete: if canUpdateOwnResource();
    }
    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (canReadResource() || canReadSharedResource());
      allow create: if canWriteOwnResource();
      allow update, delete: if canUpdateOwnResource();
    }
    match /suppliers/{id} {
      allow read: if isSignedIn() && (canReadResource() || canReadSharedResource());
      allow create: if canWriteOwnResource();
      allow update, delete: if canUpdateOwnResource();
    }
    match /deliveries/{id} {
      allow read: if isSignedIn() && canReadResource();
      allow create: if canWriteOwnResource();
      allow update, delete: if canUpdateOwnResource();
    }
    match /reminders/{id} {
      allow read: if isSignedIn() && canReadResource();
      allow create: if canWriteOwnResource();
      allow update, delete: if canUpdateOwnResource();
    }
    match /companies/{companyId} {
      // L'entreprise "par défaut" (sans userId) est gérée par l'initialiseur.
      allow read: if isSignedIn();
      allow create: if isAdmin() || isSignedIn();
      // 🔒 La société par défaut ne peut être modifiée QUE par l'admin
      // (avant : n'importe quel utilisateur pouvait la falsifier).
      allow update, delete: if isAdmin() || isOwner()
        || (companyId == 'default_company' && isAdmin());
    }
    match /dashboard_stats/{id} {
      allow read, write: if isSignedIn() && canUpdateOwnResource();
    }
    match /financial_stats/{id} {
      allow read, write: if isSignedIn() && canUpdateOwnResource();
    }
    match /analytics_data/{id} {
      allow read, write: if isSignedIn() && canUpdateOwnResource();
    }
    match /line_items/{id} {
      allow read: if isSignedIn() && canReadResource();
      allow create: if canWriteOwnResource();
      allow update, delete: if canUpdateOwnResource();
    }

    // ===========================================
    // ABONNEMENTS / SOUSCRIPTIONS / PLANS
    // ===========================================
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && (isAdmin() || isOwner());
      allow create: if isAdmin() || (isSignedIn() && isNewOwner());
      allow update, delete: if isAdmin();
    }
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Un utilisateur peut créer/lire/mettre à jour SON propre profil.
    // Il ne peut JAMAIS s'auto-attribuer un rôle admin (hasAdminPrivileges).
    // `subscriptionId` est modifiable (activation d'abonnement), mais pas
    // `isActive` (réservé à l'admin/backend).
    match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId
        && !hasAdminPrivileges(request.resource.data);
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && !hasAdminPrivileges(request.resource.data)
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['isActive']));
    }

    // ===========================================
    // MODULE ÉQUIPE (Business) + PARTAGES
    // ===========================================
    match /teams/{teamId} {
      allow read: if isSignedIn() && (isAdmin()
        || resource.data.ownerId == request.auth.uid
        || request.auth.uid in resource.data.memberIds);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin()
        || resource.data.ownerId == request.auth.uid;
    }
    match /shared_invoices/{sharedId} {
      allow read: if isSignedIn() && (isAdmin()
        || request.auth.uid in resource.data.sharedWith
        || resource.data.sharedBy == request.auth.uid);
      // 🔒 Création : l'émetteur doit être membre de l'équipe (anti-spam /
      // anti-partage vers des équipes dont on ne fait pas partie).
      // NB : la liste des destinataires n'est pas itérable dans les règles
      // Firestore ; la protection des destinataires est assurée par la règle
      // d'écriture des notifications (@mention intra-équipe) et par le fait
      // que seul le propriétaire peut marquer un document comme partagé
      // (sharedWithUsers) pour donner l'accès.
      allow create: if isSignedIn()
        && request.resource.data.sharedBy == request.auth.uid
        && request.resource.data.teamId is string
        && isTeamMember(request.resource.data.teamId, request.auth.uid);
      allow update, delete: if isAdmin()
        || resource.data.sharedBy == request.auth.uid;
    }

    // ===========================================
    // INVITATIONS D'ÉQUIPE
    // ===========================================
    // Créées et traitées par le SERVEUR (SDK admin, contourne les règles).
    // Le client peut seulement LIRE les invitations qui le concernent
    // (invité) ou celles de ses équipes (pour afficher les statuts).
    match /team_invitations/{invitationId} {
      allow read: if isSignedIn() && (isAdmin()
        || resource.data.inviteeUid == request.auth.uid
        || isTeamMember(resource.data.teamId, request.auth.uid));
      allow write: if isAdmin();
    }

    // ===========================================
    // SYSTÈME
    // ===========================================
    match /templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /notifications/{notificationId} {
      // Lecture : admin, propriétaire, ou destinataire @mentionné.
      allow read: if isSignedIn() && (isAdmin() || isOwner()
        || (request.auth.uid in resource.data.recipients));
      // 🔒 Écriture : admin, propriétaire, ou @mention intra-équipe —
      // l'émetteur ET le destinataire doivent être membres de la même équipe
      // (anti-spam de notifications vers des inconnus).
      allow write: if isAdmin() || isSignedIn() && (isNewOwner()
        || (request.resource.data.createdBy == request.auth.uid
            && request.resource.data.teamId is string
            && isTeamMember(request.resource.data.teamId, request.auth.uid)
            && request.resource.data.userId is string
            && isTeamMember(request.resource.data.teamId, request.resource.data.userId)));
    }
    match /logs/{logId} {
      allow read, write: if isAdmin();
    }
    match /drive_sync/{syncId} {
      allow read: if isSignedIn() && (isAdmin()
        || resource.data.userId == request.auth.uid);
      allow write: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
    }
    // Compteurs de numérotation : chaque utilisateur n'écrit que le sien.
    match /counters/{counterId} {
      allow read, write: if isSignedIn() && request.auth.uid == counterId;
    }

    // ===========================================
    // PORTEFEUILLE MARCHAND (encaissement client)
    // ===========================================
    match /wallets/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());
      // 🔒 Seule la plateforme (serveur / SDK admin) modifie le solde —
      // un utilisateur ne peut PLUS s'auto-créditer un montant arbitraire.
      allow write: if isAdmin();
    }
    match /wallet_transactions/{id} {
      allow read: if isSignedIn()
        && (isAdmin() || resource.data.userId == request.auth.uid);
      // 🔒 Écriture serveur uniquement (crédit/débit vérifiés par le serveur).
      allow create: if isAdmin();
    }
    match /wallet_withdrawals/{id} {
      allow read: if isSignedIn()
        && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      // La plateforme (admin) met à jour le statut (paid / rejected).
      allow update: if isAdmin();
    }
  }
}
