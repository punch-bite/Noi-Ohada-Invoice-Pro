# ==============================================================
# Noi Ohada Invoice Pro - Variables d'environnement
# ==============================================================
# .env n'est PAS embarque dans l'application (secrets).
# Il est lu localement par ConfigService (mobile/desktop).
# Sur web, les valeurs par defaut du code sont utilisees.
# ==============================================================

# API backend (Node.js / server)
API_BASE_URL=https://api.noi-ohada-invoice-pro.com

# Enkap (paiement)
ENKAP_BASE_URL=https://gateway.sepush.co.za
ENKAP_TOKEN_URL=https://gateway.sepush.co.za/token
