# ===== Serveur de callback NotchPay =====
# Port d'écoute
PORT=8080

# 🔐 SECRET du webhook NotchPay (NOCHPAY_WEBHOOK_SECRET dans votre .env Flutter)
# Exemple : hsk_test.xxxxxxxxxxxx
NOCHPAY_WEBHOOK_SECRET=hsk_test.REMPLACER

# --- Connexion Firestore (au choix) ---
# Option 1 : clé de compte de service en base64 (recommandé pour les plateformes)
#   PowerShell : [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
FIREBASE_SERVICE_ACCOUNT=

# Option 2 : chemin vers la clé (défaut : ../serviceAccountKey.json)
# GOOGLE_APPLICATION_CREDENTIALS=../serviceAccountKey.json
