# ===== Serveur de callbacks (ENKAP) =====
# Port d'écoute
PORT=8080

# --- Clés ENKAP (le serveur relaie les appels web via le proxy /enkap/*) ---
ENKAP_CONSUMER_KEY=
ENKAP_CONSUMER_SECRET=
ENKAP_TOKEN_URL=https://api-v2.enkap.cm/token
# ENKAP_ACCESS_TOKEN= (optionnel : jeton direct au lieu des clés)

# --- Connexion Firestore (au choix) ---
# Option 1 : clé de compte de service en base64 (recommandé pour les plateformes)
#   PowerShell : [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
FIREBASE_SERVICE_ACCOUNT=

# Option 2 : chemin vers la clé (défaut : ../serviceAccountKey.json)
# GOOGLE_APPLICATION_CREDENTIALS=../serviceAccountKey.json

# --- SMTP (envoi des emails : invitations d'équipe, notifications, factures) ---
# ⚠️ OBLIGATOIRE pour que les invitations d'équipe et les mails fonctionnent.
# Sur Vercel : Settings → Environment Variables → ajouter ces 6 variables.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Noi OHADA Invoice Pro
# Timeouts (ms) — évitent de bloquer la fonction serverless Vercel (>10s = 504).
SMTP_CONNECT_TIMEOUT=5000
SMTP_SOCKET_TIMEOUT=5000
